PORT=5000
NODE_ENV=development

# MongoDB — use Atlas for production, local for dev
MONGODB_URI=mongodb://localhost:27017/interior_platform

# JWT secrets — generate strong random values for production
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_production_use_32_chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production_use_32_chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Admin email for notifications
ADMIN_EMAIL=admin@interior.com
