NODE_ENV=development
PORT=5000

# Required — use MongoDB Atlas for local dev (local MongoDB is optional)
# Get a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/interior_platform?retryWrites=true&w=majority

# Production: must be unique secrets, min 32 chars (server refuses weak secrets when NODE_ENV=production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Local Vite: http://localhost:5173
# Production same-origin (SPA + API on one host): FRONTEND_URL=same-origin
# Production split hosts: FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Admin notification email
ADMIN_EMAIL=admin@interior.com

# Email notifications (Gmail: use App Password, not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Image uploads — https://cloudinary.com (free tier available)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments — https://stripe.com (test keys for development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Reviews sync — https://console.cloud.google.com
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
